[
  { "name": "i enters insert at the cursor", "text": "hel|lo", "keys": "i", "expect": "hel|lo", "mode": "insert" },
  { "name": "a inserts after the character", "text": "hel|lo", "keys": "a", "expect": "hell|o", "mode": "insert" },
  { "name": "a on the last character", "text": "hell|o", "keys": "a", "expect": "hello|", "mode": "insert" },
  { "name": "a on an empty line stays", "text": "one\n|\nthree", "keys": "a", "expect": "one\n|\nthree", "mode": "insert" },
  { "name": "I goes to the first non-blank", "text": "  ab|c", "keys": "I", "expect": "  |abc", "mode": "insert" },
  { "name": "A goes to the end of the line", "text": "|abc\ndef", "keys": "A", "expect": "abc|\ndef", "mode": "insert" },
  { "name": "A on the last line", "text": "abc\nd|ef", "keys": "A", "expect": "abc\ndef|", "mode": "insert" },
  { "name": "o opens a line below", "text": "a|bc\ndef", "keys": "o", "expect": "abc\n|\ndef", "mode": "insert" },
  { "name": "o on the last line", "text": "abc\nd|ef", "keys": "o", "expect": "abc\ndef\n|", "mode": "insert" },
  { "name": "O opens a line above", "text": "abc\nd|ef", "keys": "O", "expect": "abc\n|\ndef", "mode": "insert" },
  { "name": "O on the first line", "text": "a|bc", "keys": "O", "expect": "|\nabc", "mode": "insert" },
  { "name": "Escape from insert moves left", "text": "ab|c", "keys": "i<Esc>", "expect": "a|bc" },
  { "name": "Escape from insert at line start stays", "text": "abc\n|def", "keys": "i<Esc>", "expect": "abc\n|def" },
  { "name": "typed text then Escape", "text": "|world", "keys": "ihello <Esc>", "expect": "hello| world" },
  { "name": "A then Escape lands on the last character", "text": "|abc\ndef", "keys": "A<Esc>", "expect": "ab|c\ndef" },
  { "name": "o, type, Escape", "text": "|abc", "keys": "oxy<Esc>", "expect": "abc\nx|y" },
  { "name": "Escape in normal mode does nothing", "text": "ab|c", "keys": "<Esc>", "expect": "ab|c" },

  { "name": "h", "text": "abc|d", "keys": "h", "expect": "ab|cd" },
  { "name": "3h stops at the line start", "text": "ab\nc|de", "keys": "3h", "expect": "ab\n|cde" },
  { "name": "h at the line start stays", "text": "ab\n|cd", "keys": "h", "expect": "ab\n|cd" },
  { "name": "l", "text": "a|bcd", "keys": "l", "expect": "ab|cd" },
  { "name": "5l stops at the last character", "text": "a|bc\nde", "keys": "5l", "expect": "ab|c\nde" },
  { "name": "l on the last character stays", "text": "ab|c\nde", "keys": "l", "expect": "ab|c\nde" },
  { "name": "l on an empty line stays", "text": "a\n|\nb", "keys": "l", "expect": "a\n|\nb" },
  { "name": "10l: zero extends a count", "text": "|0123456789abc", "keys": "10l", "expect": "0123456789|abc" },

  { "name": "0 goes to the line start", "text": "x\n  ab|c", "keys": "0", "expect": "x\n|  abc" },
  { "name": "^ goes to the first non-blank", "text": "|  abc", "keys": "^", "expect": "  |abc" },
  { "name": "^ on an all-blank line", "text": "x\n|   \ny", "keys": "^", "expect": "x\n  | \ny" },
  { "name": "$ goes to the last character", "text": "|abc\nde", "keys": "$", "expect": "ab|c\nde" },
  { "name": "2$ goes to the end of the next line", "text": "|abc\nde\nf", "keys": "2$", "expect": "abc\nd|e\nf" },
  { "name": "$ on an empty line stays", "text": "a\n|\nb", "keys": "$", "expect": "a\n|\nb" },
  { "name": "$ on the last line", "text": "x\n|abc", "keys": "$", "expect": "x\nab|c" },

  { "name": "w goes to the next word", "text": "|foo bar", "keys": "w", "expect": "foo |bar" },
  { "name": "w: punctuation is its own word", "text": "|foo.bar baz", "keys": "w", "expect": "foo|.bar baz" },
  { "name": "w: letters, digits and _ are one word", "text": "|a_1b+c", "keys": "w", "expect": "a_1b|+c" },
  { "name": "w crosses lines and skips indent", "text": "fo|o\n  bar", "keys": "w", "expect": "foo\n  |bar" },
  { "name": "w stops at an empty line", "text": "fo|o\n\nbar", "keys": "w", "expect": "foo\n|\nbar" },
  { "name": "w does not stop at an all-blank line", "text": "fo|o\n   \nbar", "keys": "w", "expect": "foo\n   \n|bar" },
  { "name": "3w", "text": "|a b c d", "keys": "3w", "expect": "a b c |d" },
  { "name": "w on the last word goes to the last character", "text": "foo b|ar", "keys": "w", "expect": "foo ba|r" },

  { "name": "b goes to the start of the word", "text": "foo ba|r", "keys": "b", "expect": "foo |bar" },
  { "name": "b from a word start goes to the previous word", "text": "foo |bar", "keys": "b", "expect": "|foo bar" },
  { "name": "b crosses lines", "text": "foo\n|bar", "keys": "b", "expect": "|foo\nbar" },
  { "name": "b stops at an empty line", "text": "foo\n\n|bar", "keys": "b", "expect": "foo\n|\nbar" },
  { "name": "2b with punctuation", "text": "a.b |cd", "keys": "2b", "expect": "a|.b cd" },
  { "name": "b at the start of the text stays", "text": "|foo", "keys": "b", "expect": "|foo" },

  { "name": "e goes to the end of the word", "text": "|foo bar", "keys": "e", "expect": "fo|o bar" },
  { "name": "e from a word end goes to the next word end", "text": "fo|o bar", "keys": "e", "expect": "foo ba|r" },
  { "name": "e skips empty lines", "text": "fo|o\n\n  bar", "keys": "e", "expect": "foo\n\n  ba|r" },
  { "name": "e: punctuation run", "text": "|ab.,cd", "keys": "2e", "expect": "ab.|,cd" },
  { "name": "e at the end of the text stays", "text": "foo ba|r", "keys": "e", "expect": "foo ba|r" },

  { "name": "gg goes to the first line", "text": "abc\nd|ef", "keys": "gg", "expect": "|abc\ndef" },
  { "name": "gg lands on the first non-blank", "text": "  abc\nd|ef", "keys": "gg", "expect": "  |abc\ndef" },
  { "name": "2gg goes to line 2", "text": "|a\n  b\nc", "keys": "2gg", "expect": "a\n  |b\nc" },
  { "name": "G goes to the last line", "text": "|a\nb\n  c", "keys": "G", "expect": "a\nb\n  |c" },
  { "name": "2G goes to line 2", "text": "|a\n  b\nc", "keys": "2G", "expect": "a\n  |b\nc" },
  { "name": "9G past the end goes to the last line", "text": "|a\nb", "keys": "9G", "expect": "a\n|b" },
  { "name": "G with a trailing newline goes to the empty last line", "text": "|a\nb\n", "keys": "G", "expect": "a\nb\n|" },

  { "name": "x deletes the character", "text": "a|bc", "keys": "x", "expect": "a|c" },
  { "name": "x on the last character moves left", "text": "ab|c\nd", "keys": "x", "expect": "a|b\nd" },
  { "name": "3x", "text": "|abcd", "keys": "3x", "expect": "|d" },
  { "name": "5x stops at the end of the line", "text": "a|bc\nd", "keys": "5x", "expect": "|a\nd" },
  { "name": "x on an empty line does nothing", "text": "a\n|\nb", "keys": "x", "expect": "a\n|\nb" },
  { "name": "x on the only character", "text": "|a", "keys": "x", "expect": "|" },
  { "name": "Delete acts like x", "text": "a|bc", "keys": "<Del>", "expect": "a|c" },

  { "name": "dd deletes the line", "text": "one\nt|wo\n  three", "keys": "dd", "expect": "one\n  |three" },
  { "name": "dd on the last line", "text": "one\ntw|o", "keys": "dd", "expect": "|one" },
  { "name": "dd on the last line lands on the first non-blank", "text": "  one\ntw|o", "keys": "dd", "expect": "  |one" },
  { "name": "dd on the only line", "text": "ab|c", "keys": "dd", "expect": "|" },
  { "name": "2dd", "text": "|a\nb\nc", "keys": "2dd", "expect": "|c" },
  { "name": "5dd deletes what is left", "text": "a\n|b\nc", "keys": "5dd", "expect": "|a" },
  { "name": "dd with a trailing newline", "text": "a\n|b\n", "keys": "dd", "expect": "a\n|" },
  { "name": "dd on an empty line", "text": "a\n|\nb", "keys": "dd", "expect": "a\n|b" },

  { "name": "Escape clears a count", "text": "|abcdef", "keys": "3<Esc>l", "expect": "a|bcdef" },
  { "name": "g then another key cancels", "text": "a|bc", "keys": "gl", "expect": "a|bc", "nvim": false },
  { "name": "d then another key cancels", "text": "a|bc", "keys": "dl", "expect": "a|bc", "nvim": false },
  { "name": "count is cleared after a cancelled command", "text": "|abcdef", "keys": "3gll", "expect": "a|bcdef", "nvim": false },
  { "name": "unknown key does nothing", "text": "a|bc", "keys": "Q", "expect": "a|bc", "nvim": false },
  { "name": "space does nothing", "text": "a|bc", "keys": " ", "expect": "a|bc", "nvim": false },
  { "name": "Return does nothing", "text": "a|bc\nd", "keys": "<CR>", "expect": "a|bc\nd", "nvim": false },
  { "name": "Backspace does nothing", "text": "a|bc", "keys": "<BS>", "expect": "a|bc", "nvim": false },
  { "name": "Tab does nothing", "text": "a|bc", "keys": "<Tab>", "expect": "a|bc", "nvim": false },

  { "name": "j asks for one screen line down", "text": "a|bc", "keys": "j", "expect": "a|bc", "action": { "type": "screenLine", "count": 1 }, "nvim": false },
  { "name": "3j asks for three screen lines down", "text": "a|bc", "keys": "3j", "expect": "a|bc", "action": { "type": "screenLine", "count": 3 }, "nvim": false },
  { "name": "k asks for one screen line up", "text": "a|bc", "keys": "k", "expect": "a|bc", "action": { "type": "screenLine", "count": -1 }, "nvim": false },
  { "name": "2k asks for two screen lines up", "text": "a|bc", "keys": "2k", "expect": "a|bc", "action": { "type": "screenLine", "count": -2 }, "nvim": false },
  { "name": "u asks for undo", "text": "a|bc", "keys": "u", "expect": "a|bc", "action": { "type": "undo", "count": 1 }, "nvim": false },
  { "name": "3u asks for three undos", "text": "a|bc", "keys": "3u", "expect": "a|bc", "action": { "type": "undo", "count": 3 }, "nvim": false },
  { "name": "Ctrl+R asks for redo", "text": "a|bc", "keys": "<C-r>", "expect": "a|bc", "action": { "type": "redo", "count": 1 }, "nvim": false }
]
